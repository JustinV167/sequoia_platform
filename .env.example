# Platform-level environment shared by the API and frontend.
# Copy this file to .env and replace the placeholder secrets.
NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=sequoia
DB_PASSWORD=sequoia_pass
DB_NAME=sequoia
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

REGISTRATION_TOKEN_SECRET=change-this-registration-secret
REGISTRATION_TOKEN_TTL_SECONDS=900
SESSION_SECRET=change-this-session-secret
SESSION_COOKIE_NAME=sequoia_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
OTP_PEPPER=change-this-otp-pepper

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false

# Course images. Relative paths resolve from the backend working directory.
UPLOADS_DIR=src/uploads/files

# Google Workspace/Gmail SMTP. Use an App Password, not your normal account password.
# Leave SMTP_HOST empty to log OTP codes to the console in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=Sequoia <your-email@gmail.com>

# Frontend (Vite). Must include the /api prefix.
VITE_API_URL=http://localhost:3001/api

# MongoDB course templates.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=sequoia
